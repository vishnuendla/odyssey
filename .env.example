# Copy this file to .env and replace the placeholder secrets before deploying.
# docker compose refuses to start if the required values are missing.

# Required
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-database-password
# The application connects with this non-root account, not as root.
MYSQL_APP_USER=odyssey
MYSQL_APP_PASSWORD=change-me-to-another-strong-password
JWT_SECRET=change-me-to-at-least-32-random-characters

# Public URLs
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Database
MYSQL_DATABASE=odyssey_db

# Geocoding (optional). The key stays on the server and is proxied through
# /api/locations/**; leave empty to hide location suggestions.
GEOAPIFY_API_KEY=

# Email. Use "smtp" with real credentials for production; "log" writes links to
# the container logs instead of sending mail.
MAIL_MODE=log
MAIL_FROM=no-reply@odyssey.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Limits
RATE_LIMIT_ENABLED=true
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC
